{
  "title": "Infrastructure Monitoring",
  "version": 2,
  "timezone": "browser",
  "schemaVersion": 39,
  "templating": {
    "list": [
      {
        "name": "ds",
        "type": "datasource",
        "query": "prometheus",
        "label": "Data Source",
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "title": "Total Containers",
      "type": "stat",
      "gridPos": {"w": 6, "h": 4, "x": 0, "y": 0},
      "targets": [{"expr": "count(container_last_seen{name!=\"\"})", "legendFormat": ""}],
      "datasource": {"type": "prometheus", "uid": "${ds}"},
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {"mode": "background"},
          "thresholds": {"steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}
        }
      }
    },
    {
      "title": "Total CPU (16 cores)",
      "type": "gauge",
      "gridPos": {"w": 6, "h": 4, "x": 6, "y": 0},
      "targets": [{"expr": "sum(rate(container_cpu_usage_seconds_total{name!=\"\"}[1m])) * 100 / max(machine_cpu_cores)", "legendFormat": ""}],
      "datasource": {"type": "prometheus", "uid": "${ds}"},
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "color": {"mode": "thresholds"},
          "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "orange", "value": 50}, {"color": "red", "value": 80}]}
        }
      },
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "showThresholdLabels": false, "showThresholdMarkers": true}
    },
    {
      "title": "Total RAM (19.2 GB)",
      "type": "gauge",
      "gridPos": {"w": 6, "h": 4, "x": 12, "y": 0},
      "targets": [{"expr": "sum(container_memory_usage_bytes{name!=\"\"}) / max(machine_memory_bytes) * 100", "legendFormat": ""}],
      "datasource": {"type": "prometheus", "uid": "${ds}"},
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "color": {"mode": "thresholds"},
          "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "orange", "value": 50}, {"color": "red", "value": 80}]}
        }
      },
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "showThresholdLabels": false, "showThresholdMarkers": true}
    },
    {
      "title": "Total Disk Used",
      "type": "stat",
      "gridPos": {"w": 6, "h": 4, "x": 18, "y": 0},
      "targets": [{"expr": "sum(container_fs_usage_bytes{device=~\"/dev/mapper/.*\"})", "legendFormat": ""}],
      "datasource": {"type": "prometheus", "uid": "${ds}"},
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 1,
          "color": {"mode": "background"},
          "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "orange", "value": 10737418240}, {"color": "red", "value": 21474836480}]}
        }
      }
    },
    {
      "title": "CPU per Container",
      "type": "timeseries",
      "gridPos": {"w": 12, "h": 8, "x": 0, "y": 4},
      "targets": [{
        "expr": "rate(container_cpu_usage_seconds_total{name!=\"\"}[1m]) * 100",
        "legendFormat": "{{name}}"
      }],
      "datasource": {"type": "prometheus", "uid": "${ds}"}
    },
    {
      "title": "Memory per Container",
      "type": "timeseries",
      "gridPos": {"w": 12, "h": 8, "x": 12, "y": 4},
      "targets": [{
        "expr": "container_memory_usage_bytes{name!=\"\"} / 1024 / 1024",
        "legendFormat": "{{name}}"
      }],
      "datasource": {"type": "prometheus", "uid": "${ds}"}
    },
    {
      "title": "Container Uptime",
      "type": "timeseries",
      "gridPos": {"w": 12, "h": 8, "x": 0, "y": 12},
      "targets": [{
        "expr": "time() - container_start_time_seconds{name!=\"\"}",
        "legendFormat": "{{name}}"
      }],
      "datasource": {"type": "prometheus", "uid": "${ds}"}
    },
    {
      "title": "PostgreSQL Active Connections",
      "type": "timeseries",
      "gridPos": {"w": 12, "h": 8, "x": 12, "y": 12},
      "targets": [{
        "expr": "pg_stat_database_numbackends{datname=~\"batch_data|stream_data\"}",
        "legendFormat": "{{datname}}"
      }],
      "datasource": {"type": "prometheus", "uid": "${ds}"}
    },
    {
      "title": "PostgreSQL Cache Hit Ratio",
      "type": "timeseries",
      "gridPos": {"w": 12, "h": 8, "x": 0, "y": 20},
      "targets": [{
        "expr": "(pg_stat_database_blks_hit{datname=~\"batch_data|stream_data\"} / (pg_stat_database_blks_hit{datname=~\"batch_data|stream_data\"} + pg_stat_database_blks_read{datname=~\"batch_data|stream_data\"})) * 100",
        "legendFormat": "{{datname}}"
      }],
      "datasource": {"type": "prometheus", "uid": "${ds}"}
    },
    {
      "title": "Kafka Messages per Topic",
      "type": "timeseries",
      "gridPos": {"w": 24, "h": 8, "x": 0, "y": 28},
      "targets": [{
        "expr": "kafka_topic_partition_current_offset{topic=~\"bus.*\"}",
        "legendFormat": "{{topic}}"
      }],
      "datasource": {"type": "prometheus", "uid": "${ds}"}
    },
    {
      "title": "Network I/O per Container",
      "type": "timeseries",
      "gridPos": {"w": 12, "h": 8, "x": 12, "y": 20},
      "targets": [
        {
          "expr": "rate(container_network_receive_bytes_total{name!=\"\"}[1m]) / 1024",
          "legendFormat": "RX {{name}}"
        },
        {
          "expr": "rate(container_network_transmit_bytes_total{name!=\"\"}[1m]) / 1024",
          "legendFormat": "TX {{name}}"
        }
      ],
      "datasource": {"type": "prometheus", "uid": "${ds}"}
    }
  ]
}
