# --- Tailscale IP ---
BATCH_TAILSCALE_IP=localhost
STREAM_TAILSCALE_IP=localhost

# --- PostgreSQL ---
POSTGRES_PASSWORD=postgres
POSTGRES_DB=stream_data
POSTGRES_USER=postgres

# --- Kafka ---
# Kafka listener hostname (gunakan 0.0.0.0 agar bisa diakses dari luar)
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://${STREAM_TAILSCALE_IP}:9092
KAFKA_LISTENERS=PLAINTEXT://0.0.0.0:9092

# --- MLflow (dari batch laptop) ---
MLFLOW_TRACKING_URI=http://${BATCH_TAILSCALE_IP}:5000

# --- MinIO ---
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=admin

# --- WMATA API ---
WMATA_API_KEY=
