{
  "title": "Inference Monitoring",
  "version": 2,
  "timezone": "browser",
  "schemaVersion": 39,
  "panels": [
    {
      "title": "Model Status",
      "type": "stat",
      "gridPos": {"w": 4, "h": 4, "x": 0, "y": 0},
      "targets": [{"expr": "inference_model_loaded", "legendFormat": ""}],
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {"mode": "background"},
          "thresholds": {"steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}
        }
      }
    },
    {
      "title": "Total Predictions",
      "type": "stat",
      "gridPos": {"w": 4, "h": 4, "x": 4, "y": 0},
      "targets": [{"expr": "sum(inference_predictions_total)", "legendFormat": ""}],
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {"mode": "background"},
          "thresholds": {"steps": [{"color": "green", "value": null}]}
        }
      }
    },
    {
      "title": "Stops Loaded",
      "type": "stat",
      "gridPos": {"w": 4, "h": 4, "x": 8, "y": 0},
      "targets": [{"expr": "inference_stops_loaded", "legendFormat": ""}],
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {"mode": "background"},
          "thresholds": {"steps": [{"color": "red", "value": null}, {"color": "orange", "value": 7000}, {"color": "green", "value": 7500}]}
        }
      }
    },
    {
      "title": "Kafka Messages",
      "type": "stat",
      "gridPos": {"w": 4, "h": 4, "x": 12, "y": 0},
      "targets": [{"expr": "inference_kafka_messages_consumed_total", "legendFormat": ""}],
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {"mode": "background"},
          "thresholds": {"steps": [{"color": "green", "value": null}]}
        }
      }
    },
    {
      "title": "Active Routes",
      "type": "stat",
      "gridPos": {"w": 4, "h": 4, "x": 16, "y": 0},
      "targets": [{"expr": "count(inference_predictions_total)", "legendFormat": ""}],
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {"mode": "background"},
          "thresholds": {"steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}
        }
      }
    },
    {
      "title": "Last Prediction (detik)",
      "type": "stat",
      "gridPos": {"w": 4, "h": 4, "x": 20, "y": 0},
      "targets": [{"expr": "time() - inference_last_prediction_timestamp", "legendFormat": ""}],
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {"mode": "background"},
          "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "orange", "value": 120}, {"color": "red", "value": 600}]}
        }
      }
    },
    {
      "title": "Predictions per 5m",
      "type": "timeseries",
      "gridPos": {"w": 12, "h": 8, "x": 0, "y": 4},
      "targets": [{
        "expr": "increase(inference_predictions_total[5m])",
        "legendFormat": "{{route_id}}"
      }],
      "datasource": {"type": "prometheus", "uid": "prometheus"}
    },
    {
      "title": "Errors per 5m",
      "type": "timeseries",
      "gridPos": {"w": 12, "h": 8, "x": 12, "y": 4},
      "targets": [{
        "expr": "increase(inference_errors_total[5m])",
        "legendFormat": "{{error_type}}"
      }],
      "datasource": {"type": "prometheus", "uid": "prometheus"}
    },
    {
      "title": "Prediction Latency (p95)",
      "type": "timeseries",
      "gridPos": {"w": 12, "h": 8, "x": 0, "y": 12},
      "targets": [{
        "expr": "histogram_quantile(0.95, sum(rate(inference_latency_seconds_bucket[5m])) by (le))",
        "legendFormat": "p95"
      }],
      "datasource": {"type": "prometheus", "uid": "prometheus"}
    },
    {
      "title": "Kafka Msgs per second",
      "type": "timeseries",
      "gridPos": {"w": 12, "h": 8, "x": 12, "y": 12},
      "targets": [{
        "expr": "rate(inference_kafka_messages_consumed_total[5m])",
        "legendFormat": "msgs/s"
      }],
      "datasource": {"type": "prometheus", "uid": "prometheus"}
    }
  ]
}
